{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/services/backend",
      "jinja": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/services/backend",
        "TRAINING_SERVICE_URL": "http://localhost:8001"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend: Vite",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/services/frontend",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full stack: Backend + Frontend",
      "configurations": [
        "Backend: FastAPI (uvicorn)",
        "Frontend: Vite"
      ],
      "stopAll": true
    }
  ]
}
